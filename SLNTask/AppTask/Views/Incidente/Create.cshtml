@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Novo Incidente";
}

<h1 class="mb-4">Cadastrar Incidente</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form action="/Incidente/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="DescricaoProblema" class="form-label">Descrição do Problema</label>
                <input type="text" id="DescricaoProblema" name="DescricaoProblema"
                       class="form-control" placeholder="Descreva o problema" required />
            </div>

            <div class="mb-3">
                <label for="DataIncidente" class="form-label">Data do Incidente</label>
                <input type="datetime-local" id="DataIncidente" name="DataIncidente"
                       class="form-control" required />
            </div>

            <div class="mb-3">
                <label for="Solucao" class="form-label">Solução</label>
                <input type="text" id="Solucao" name="Solucao"
                       class="form-control" placeholder="Descreva a solução" />
            </div>

            <div class="mb-3">
                <label for="Resolvido" class="form-label">Resolvido</label>
                <select id="Resolvido" name="Resolvido" class="form-select" required>
                    <option value="">-- Selecione --</option>
                    <option value="true">Sim</option>
                    <option value="false">Não</option>
                </select>
            </div>

            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a href="/Incidente/Index" class="btn btn-secondary">Voltar para a Lista</a>
            </div>
        </form>
    </div>
</div>
